# ---------- Приложение ----------
NODE_ENV=development
PORT=3000
# Базовый публичный адрес приложения — нужен, чтобы собрать magic-link в письме
APP_URL=http://localhost:3000

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=course_app
# true — TypeORM сам создаёт/меняет таблицы под сущности. ТОЛЬКО для разработки.
DB_SYNCHRONIZE=true
# true — печатать в консоль каждый SQL-запрос (полезно, пока учишься)
DB_LOGGING=true

# ---------- SMTP (turboSMTP) ----------
# console — печатать письма в консоль (для разработки, доступы не нужны)
# smtp    — отправлять по-настоящему через turboSMTP
MAIL_DRIVER=console
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_USER=your_turbosmtp_login
SMTP_PASSWORD=your_turbosmtp_password
MAIL_FROM="Course App <no-reply@example.com>"

# ---------- Пароли / OTP ----------
# Стоимость bcrypt: 12 ≈ 250мс на хэш. Больше = медленнее подбор, но и медленнее вход.
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Локальное хранилище файлов ----------
UPLOAD_DIR=./assets

# ---------- Токены входа (JWT) ----------
# Секреты для подписи. Разные у access и refresh: так refresh нельзя
# подсунуть вместо access. В боевом проекте держат в защищённом хранилище.
JWT_ACCESS_SECRET=смените_на_случайную_строку
JWT_REFRESH_SECRET=смените_на_другую_случайную_строку
# Сколько живут токены
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie: Secure=true работает только по HTTPS, локально должно быть false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# RBAC
# Кому при старте выдать роль admin. Нужно один раз, чтобы появился первый
# администратор: раздел /admin/rbac/* закрыт этой ролью, а выдать её через
# API нельзя. Пользователь должен быть уже зарегистрирован.
# После первого запуска строку можно очистить.
RBAC_BOOTSTRAP_ADMIN_EMAIL=

# Просмотр чужих профилей: сколько штук за сколько секунд с одного аккаунта
PROFILE_FOREIGN_READ_LIMIT=20
PROFILE_FOREIGN_READ_WINDOW_SECONDS=60

# Изменение профиля: сколько правок за сколько секунд с одного аккаунта
PROFILE_WRITE_LIMIT=20
PROFILE_WRITE_WINDOW_SECONDS=60
# Запросы на смену почты — строже: каждый шлёт письмо на указанный адрес
EMAIL_CHANGE_LIMIT=5
EMAIL_CHANGE_WINDOW_SECONDS=3600

# Запросы на удаление аккаунта — как и смена почты, шлют письмо
DELETION_LIMIT=5
DELETION_WINDOW_SECONDS=3600

# Список пользователей для администратора
USER_LIST_LIMIT=60
USER_LIST_WINDOW_SECONDS=60

# Конвертация файлов: лимит размера на каждый исходный формат
CONVERT_MAX_CSV_BYTES=10485760
CONVERT_MAX_JSON_BYTES=5242880
CONVERT_MAX_XML_BYTES=10485760
CONVERT_MAX_YAML_BYTES=5242880
# Сколько ждать конвертацию, потом поток убивается
CONVERT_TIMEOUT_MS=30000
# Сколько конвертаций в час с одного аккаунта
CONVERT_LIMIT=60
CONVERT_WINDOW_SECONDS=3600

# Трансформация изображений: лимит размера на каждый исходный формат.
# У SVG он меньше: это разметка, и мегабайт её описывает картинку, на
# которую растру не хватило бы и сотни мегабайт
IMAGE_MAX_PNG_BYTES=10485760
IMAGE_MAX_JPEG_BYTES=10485760
IMAGE_MAX_SVG_BYTES=2097152
# Потолок сторон выходного растра при растеризации SVG
IMAGE_MAX_WIDTH=8000
IMAGE_MAX_HEIGHT=8000
# Потолок числа пикселей: и на входе, и на выходе. Заодно защита от
# "декомпрессионной бомбы" - маленького файла с огромной картинкой внутри
IMAGE_MAX_PIXELS=40000000
# Сторона растра, когда у SVG нет собственного размера
IMAGE_DEFAULT_SIZE=1024
# Сколько отведено на обработку изображения
IMAGE_TIMEOUT_MS=30000
# Качество JPEG, если клиент не указал своего
IMAGE_JPEG_QUALITY=80
# Цвет холста при растеризации SVG.
# В кавычках: без них dotenv принял бы решётку за начало комментария
IMAGE_BACKGROUND="#ffffff"

# История трансформаций: сколько дней хранить (0 - не удалять ничего)
TRANSFORMATION_HISTORY_RETENTION_DAYS=90
# Как часто убирать просроченные записи, часы
TRANSFORMATION_HISTORY_CLEANUP_HOURS=24
# Потолок размера результата, который сохраняется по save=true (32 МиБ)
TRANSFORMATION_MAX_SAVE_BYTES=33554432


