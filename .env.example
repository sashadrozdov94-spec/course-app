# ---------- Приложение ----------
NODE_ENV=development
PORT=3000
# Базовый публичный адрес приложения — нужен, чтобы собрать magic-link в письме
APP_URL=http://localhost:3000

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=course_app
# true — TypeORM сам создаёт/меняет таблицы под сущности. ТОЛЬКО для разработки.
DB_SYNCHRONIZE=true
# true — печатать в консоль каждый SQL-запрос (полезно, пока учишься)
DB_LOGGING=true

# ---------- SMTP (turboSMTP) ----------
# console — печатать письма в консоль (для разработки, доступы не нужны)
# smtp    — отправлять по-настоящему через turboSMTP
MAIL_DRIVER=console
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_USER=your_turbosmtp_login
SMTP_PASSWORD=your_turbosmtp_password
MAIL_FROM="Course App <no-reply@example.com>"

# ---------- Пароли / OTP ----------
# Стоимость bcrypt: 12 ≈ 250мс на хэш. Больше = медленнее подбор, но и медленнее вход.
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Локальное хранилище файлов ----------
UPLOAD_DIR=./storage/uploads

# ---------- Токены входа (JWT) ----------
# Секреты для подписи. Разные у access и refresh: так refresh нельзя
# подсунуть вместо access. В боевом проекте держат в защищённом хранилище.
JWT_ACCESS_SECRET=смените_на_случайную_строку
JWT_REFRESH_SECRET=смените_на_другую_случайную_строку
# Сколько живут токены
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie: Secure=true работает только по HTTPS, локально должно быть false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# RBAC
# Кому при старте выдать роль admin. Нужно один раз, чтобы появился первый
# администратор: раздел /admin/rbac/* закрыт этой ролью, а выдать её через
# API нельзя. Пользователь должен быть уже зарегистрирован.
# После первого запуска строку можно очистить.
RBAC_BOOTSTRAP_ADMIN_EMAIL=

# Просмотр чужих профилей: сколько штук за сколько секунд с одного аккаунта
PROFILE_FOREIGN_READ_LIMIT=20
PROFILE_FOREIGN_READ_WINDOW_SECONDS=60
